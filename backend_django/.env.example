# Django Core
SECRET_KEY=cambia-esta-clave-segura-en-produccion
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Supabase PostgreSQL Connection (ES02 + ES03)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS Restrictivo (Orígenes explícitos permitidos)
